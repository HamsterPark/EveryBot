# Data directory (sessions, workspace, tasks, audit)
DATA_DIR=./data

# HTTP server (Web UI + API). The API has no authentication, so it binds to
# loopback by default; only change HOST on a trusted network.
HOST=127.0.0.1
PORT=3000
# Exact origin allowed to call the API from another web page (optional).
# Leave empty to disable CORS entirely.
ALLOWED_ORIGIN=

# Mail (QQ / IMAP-SMTP)
MAIL_USER=your@qq.com
MAIL_PASS=your_authorization_code
IMAP_HOST=imap.qq.com
IMAP_PORT=993
IMAP_SECURE=true
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
# Comma-separated senders whose mail the bot answers. Empty = only mail you send
# to yourself from MAIL_USER (a warning is logged). Include your own address if
# you list others.
MAIL_ALLOWED_SENDERS=
# Comma-separated addresses that scheduled "sendMessage" tasks may mail.
# Empty = only MAIL_USER itself.
MAIL_ALLOWED_RECIPIENTS=

# LLM: any OpenAI-compatible chat-completions endpoint (SiliconFlow, OpenAI,
# DeepSeek, a local Ollama/vLLM server, ...). The older SILICONFLOW_BASE_URL /
# SILICONFLOW_API_KEY names are still accepted as fallbacks.
LLM_BASE_URL=https://api.siliconflow.com/v1
LLM_API_KEY=your_api_key
# Per-attempt timeout in ms; timeouts, 429 and 5xx are retried with backoff.
LLM_TIMEOUT_MS=60000

# Models (names as understood by your endpoint)
MODEL_DEFAULT=deepseek-ai/DeepSeek-V3
MODEL_FILES=deepseek-ai/DeepSeek-V3
MODEL_SCHEDULER=deepseek-ai/DeepSeek-V3
MODEL_MEMORY_SUMMARY=deepseek-ai/DeepSeek-V3
MODEL_MEMORY_FACTS=deepseek-ai/DeepSeek-V3

# Poll interval for Mail (ms)
POLL_INTERVAL_MS=15000

# Default agent
DEFAULT_AGENT=default
