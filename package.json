{
  "name": "everybot",
  "version": "0.1.0",
  "description": "Moltbot-Lite: Windows-first AI assistant with Web + Mail, workspace files, memory, and scheduled tasks",
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "node --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "croner": "^10.0.1",
    "dotenv": "^16.6.1",
    "imapflow": "^1.7.8",
    "mailparser": "^3.9.20",
    "nodemailer": "^9.1.1",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.19.7",
    "@types/nodemailer": "^8.0.1",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
